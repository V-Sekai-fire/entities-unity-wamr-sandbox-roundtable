build eq: CXX_EXECUTABLE_LINKER__eq_Release CMakeFiles/eq.dir/eq.cpp.o | libvmlib.a libriscv/libriscv.a || libriscv/libriscv.a libvmlib.a
  CONFIG = Release
  FLAGS = -fPIC -O3 -DNDEBUG -arch arm64
  LINK_FLAGS = -Wl,-search_paths_first -Wl,-headerpad_max_install_names
  LINK_LIBRARIES = libvmlib.a  libriscv/libriscv.a  -lm  -framework Security  -framework Foundation  -ldl
  OBJECT_DIR = CMakeFiles/eq.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = CMakeFiles/eq.dir/
  TARGET_FILE = eq
  TARGET_PDB = eq.pdb
  TARGET_SUPPORT_DIR = CMakeFiles/eq.dir


