diff --git a/pxr/base/arch/virtualMemory.cpp b/pxr/base/arch/virtualMemory.cpp
index 46f45527a..8fdfa53a3 100644
--- a/pxr/base/arch/virtualMemory.cpp
+++ b/pxr/base/arch/virtualMemory.cpp
@@ -64,6 +64,39 @@ ArchSetMemoryProtection(void const *start, size_t numBytes,
     return VirtualProtect(pageStart, len, protXlat[protection], &oldProtect);
 }
 
+#elif defined(__wasi__)
+
+// WASI has no virtual memory to reserve and commit: linear memory is one grow-only
+// block, and its emulated mmap refuses PROT_NONE. A reservation is a zeroed
+// allocation (so Sdf_Pool regions are sized to fit, see Sdf_PathPoolRegionBits),
+// committing is a no-op, and protection changes do nothing.
+#include <cstdlib>
+
+void *
+ArchReserveVirtualMemory(size_t numBytes)
+{
+    return calloc(1, numBytes);
+}
+
+bool
+ArchCommitVirtualMemoryRange(void *, size_t)
+{
+    return true;
+}
+
+bool
+ArchFreeVirtualMemory(void *start, size_t)
+{
+    free(start);
+    return true;
+}
+
+bool
+ArchSetMemoryProtection(void const *, size_t, ArchMemoryProtection)
+{
+    return true;
+}
+
 #else // not ARCH_OS_WINDOWS, assume POSIX (mmap, mprotect)
 
 void *
